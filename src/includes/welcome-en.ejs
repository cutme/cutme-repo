<div class="relative z-10 flex clamp-[px,6,24] flex-col items-center justify-center text-white c-welcome
            max-sm:overflow-hidden  
            after:absolute 
            after:opacity-3 
            after:pointer-events-none 
            after:size-full 
            after:bg-[24px_24px] 
            after:[background-size:25px_25px] gs-parallax
         lg:h-lvh
         max-lg:pt-26 max-lg:pb-16">
  <img style="visibility: hidden" itemprop="logo" src="../img/assets/logo-white.svg"
			 loading="lazy" width="145" height="28" alt="cutme - WordPress front-end developer" 
       class="absolute logo clamp-[left,1.5rem,3rem] clamp-[top,6,12] opacity-30">

  <div class="flex flex-col max-w-3xl">
    <h1 class="max-w-xl lg:max-w-screen-md mb-4 clamp-[text,1.875rem,3rem] order-2 font-serif !leading-snug opacity-0 text-center">
      <span class="char1 md:text-nowrap">Need a front-end developer</span>
      <span class="char2 md:text-nowrap">to implement your WordPress project?</span>
    </h1>

    <h2 class="tracking-wide mb-4 clamp-[text,0.75rem,1rem] opacity-50 font-light order-1 text-center"
        style="visibility: hidden">Bartosz Mediger <span class="block opacity-50">WordPress front-end &amp; designer-coder</span></h2>

    <p class="text-balance order-3 max-w-3xl mb-10 clamp-[text,1rem,1.25rem] font-light tracking-wide gsap-three mx-auto text-center js-nowidows"
       style="visibility: hidden;">

      I turn Figma and PSD designs into responsive HTML pages and WordPress themes. Pixel Perfect coding, GSAP animations, semantic code compliant with WCAG and SEO. On time, without surprises.</p>

    <div class="relative c-welcome__skills flex gap-1.5 flex-wrap clamp-[mb,10,14] order-3 opacity-60 sm:max-w-2xl justify-center mx-auto"
         style="visibility: hidden">

      <div class="arrow-skills absolute left-0 -translate-x-[80%] opacity-50 rotate-[41deg] scale-[0.6] bottom-[50%] max-lg:hidden"
           style="visibility: hidden" aria-hidden="true">
        <img src="../img/assets/arrow-03.svg" alt="" aria-hidden="true">
        <p class="absolute top-0 tracking-wider left-0 font-light text-3xl text-white -translate-x-1/2 -translate-y-[150%]">
          skills</p>
      </div>

      <span class="skill">ACF</span>
      <span class="skill">Adobe XD</span>
      <span class="skill">Figma</span>
      <span class="skill">Git</span>
      <span class="skill">Interactive GSAP animations</span>
      <span class="skill">JavaScript</span>
      <span class="skill">Pixel Perfect</span>
      <span class="skill">RWD</span>
      <span class="skill">Semantic code</span>
      <span class="skill">SEO</span>
      <span class="skill">Tailwind CSS</span>
      <span class="skill">Vite</span>
      <span class="skill">Vue.JS</span>
      <span class="skill">WCAG</span>
      <span class="skill">Webpack</span>
      <span class="skill">Web Development</span>
      <span class="skill">WordPress</span>
    </div>

    <nav class="absolute clamp-[top,6,12] clamp-[right,1.5rem,3rem] items-center nav flex opacity-0 text-sm tracking-wider" aria-label="Main navigation">
      <button type="button"
              class="hidden mr-6 text-sm tracking-wider uppercase duration-150 opacity-30 hover:opacity-70 sm:block cursor-pointer"
              data-target="#portfolio"
              aria-label="Go to portfolio">portfolio</button>
      <button type="button"
                class="hidden mr-6 text-sm tracking-wider uppercase duration-150 opacity-30 hover:opacity-70 sm:block cursor-pointer"
                data-target="#opinions"
                aria-label="Go to opinions">opinions</button>
      <button type="button"
              class="hidden mr-6 uppercase duration-150 opacity-30 hover:opacity-70 sm:block cursor-pointer"
              data-target="#contact"
              data-speed="2"
              aria-label="Go to contact">contact</button>

      <span class="pl-6 border-l border-l-gray-800">
        <a href="/"
           hreflang="pl"
           class="hidden mr-6 text-sm uppercase duration-150 opacity-30 hover:opacity-70 sm:block"
           aria-label="Przejdź do polskiej wersji strony">PL</a>
      </span>

      <a href="https://github.com/cutme?tab=repositories"
         target="_blank"
         rel="noopener noreferrer"
         class="block ml-12 text-2xl icon-github opacity-30 hover:opacity-50"
         aria-label="View GitHub repositories of Bartosz Mediger"></a>
    </nav>

    <div class="order-4 opacity-0 o-more text-center">
      <button class="button md:text-xl clamp-[px,6,10] clamp-[py,4,5]"
              data-target="#portfolio"
              data-speed="1"
              aria-label="Go to portfolio – see completed projects">See projects</button>
    </div>
  </div>

  <div class="absolute bottom-0 scale-75 opacity-30 right-10 arrow-portfolio max-lg:hidden"
       style="visibility: hidden" aria-hidden="true">
    <img src="../img/assets/arrow-02.svg" alt="">
    <p class="absolute top-0 transform -rotate-6 tracking-wider right-1 text-xl text-white normal-case font-light -translate-y-[130%]">
      portfolio</p>
  </div>
</div>
