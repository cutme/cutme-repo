<div class="c-portfolio__item c-portfolio__item--big c-portfolio__item--17" onclick="window.open('https://flowair.cutme.pl', '_blank')">
    <%- include('../corner.ejs') %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">FlowAir</h3>
        <p itemprop="description" class="clamp-[text,0.875rem,1rem]"><strong>Kodowanie projektu graficznego</strong> strony prezentującej kurtynę powietrzną SLIM. Klient prosił o dynamiczne przedstawienie swojego produktu, więc mamy tu zaimplementowane filmy poklatkowe, parallax i&nbsp;dedykowany skrypt galerii.</p>
        <button class="button button--primary button--small" type="button">Zobacz online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" srcset="./img/portfolio/flowair.webp 1x, 
    					              ./img/portfolio/flowair@2x.webp 2x" 
    					              alt="Responsywny design strony, pixel perfect w HTML i CSS Flowair" loading="lazy" width="800" height="480" 
    					              src="./img/portfolio/flowair.webp" />
    </picture>
</div>

