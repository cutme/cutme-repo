<div class="c-portfolio__item c-portfolio__item--big c-portfolio__item--07" 
         onclick="window.open('https://brandhub.cutme.pl/', '_blank')">
         <%- include('../corner.ejs') %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">BrandHub</h3>
        <p itemprop="description" class="clamp-[text,0.875rem,1rem]">Zlecenie na <strong>zakodowanie projektu</strong> wymagało precyzyjnego odwzorowania graficznego layoutu z &nbsp;zachowaniem standardu Pixel Perfect, by zapewnić profesjonalny i&nbsp;nowoczesny wygląd.</p>
        <button class="button button--primary button--small" type="button">Zobacz online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" srcset="./img/portfolio/brandhub.webp 1x, 
    					              ./img/portfolio/brandhub@2x.webp 2x" 
    					              alt="Konwersja PSD do HTML/CSS projektu BrandHub" loading="lazy" width="800" height="480" 
    					              src="./img/portfolio/brandhub.webp" />
    </picture>
</div>