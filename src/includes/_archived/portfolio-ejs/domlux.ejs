<div class="domlux c-portfolio__item c-portfolio__item--21__ c-portfolio__item--narrow" onclick="window.open('https://domlux.cutme.pl', '_blank')">
    <%- include('../corner.ejs') %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">DomLux</h3>
        <p itemprop="description" class="clamp-[text,0.875rem,1rem]">Zakodowanie projektu strony producenta ekskluzywnych mebli. Naszym wspólnym mianownikiem przy tej realizacji była dbałość o&nbsp;szczegóły i&nbsp;estetykę wykonania.</p>
        <button type="button" class="button button--primary button--small">Zobacz online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" 
             srcset="./img/portfolio/domlux.webp 1x, 
    	             ./img/portfolio/domlux@2x.webp 2x" 
             alt="Zakodowanie strony internetowej zgodnie z zasadami Pixel Perfect" loading="lazy" width="400" height="480" 
             src="./img/portfolio/domlux.webp" />					             
	</picture>
</div>
