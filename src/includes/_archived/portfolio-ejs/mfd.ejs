<div class="c-portfolio__item c-portfolio__item--18 c-portfolio__item--big" onclick="window.open('https://mfd.cutme.pl', '_blank')">    				
    <%- include('../corner.ejs') %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">MFD</h3>
        <p itemprop="description" class="clamp-[text,0.875rem,1rem]">Kompleksowe zlecenie na <strong>zakodowanie projektu graficznego</strong> oraz <strong>wdrożenie do Wordpress</strong> dla Start-up'u w&nbsp;sektorze flot wagonów kolejowych. Nowoczesne podejście w tej branży podkreślone za pomocą wielu animacji.</p>
        <button class="button button--primary button--small" type="button">Zobacz online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" srcset="./img/portfolio/mfd.webp 1x, 
