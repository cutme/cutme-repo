<div class="relative z-30 clamp-[px,6,24] bg-white"
		 id="contact">
	<div class="o-wrap js-fadeInChildren">
		<p class="md:max-w-[90%] clamp-[mb,14,32] clamp-[text,1.5rem,2.25rem]">Chcesz, aby Twój projekt graficzny został wdrożony zgodnie
			z&nbsp;najlepszymi praktykami, był w&nbsp;pełni responsywny, dopracowany w&nbsp;każdym detalu i&nbsp;robił
			świetne wrażenie? Dobrze trafiłeś!</p>

		<div class="relative lg:flex lg:justify-between clamp-[pb,16,40]">
			<%- include('social.ejs') %>
      <%- include('contactform.ejs') %>

			<p class="absolute text-sm duration-150 lg:right-0 bottom-12 opacity-30 hover:opacity-50">&copy; <a
					 href="https://mediger.net"
					 target="_blank">mediger.net</a></p>
		</div>
	</div>
</div>