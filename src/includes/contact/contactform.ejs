<form action="https://cutme.pl/contact.php"
      method="post"
      id="contactForm"
      novalidate
      class="c-contactform lg:w-1/2">
  <fieldset id="formFields"
            class="js-fadeInChildren ">
    <span class="input">
      <label class="input__label"
             for="input-0">
        <span class="input__label-content">Imię i nazwisko</span>
      </label>
      <input class="input__field"
             type="text"
             id="input-0"
             name="name"
             autocomplete="off">

      <svg class="graphic"
           width="300%"
           height="100%"
           viewBox="0 0 1200 60"
           preserveAspectRatio="none">

        <path
              d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0" />
      </svg>
    </span>

    <span class="input">
      <label class="input__label"
             for="input-1">
        <span class="input__label-content">Twój adres e-mail</span>
      </label>
      <input class="input__field"
             type="email"
             id="input-1"
             name="email"
             autocomplete="off">

      <svg class="graphic"
           width="300%"
           height="100%"
           viewBox="0 0 1200 60"
           preserveAspectRatio="none">

        <path
              d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0" />
      </svg>
    </span>

    <span class="input">
      <label class="input__label"
             for="input-2">
        <span class="input__label-content">Opisz krótko swój projekt</span>
      </label>
      <textarea rows="1"
                class="input__field input__field--textarea"
                id="input-2"
                name="message"></textarea>

      <svg class="graphic"
           width="300%"
           height="100%"
           viewBox="0 0 1200 60"
           preserveAspectRatio="none">

        <path
              d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0" />
      </svg>
    </span>

    <div class="mt-6 mb-12 duration-150 dropzone" id="my-dropzone"></div>

    <div id="recaptcha" class="mb-6"></div>

    <div class="c-contactform__submit">
      <button type="submit" 
              id="submita"
              data-target="#contact"
              data-speed="1"
              aria-label="Przejdź do sekcji kontakt – zapytaj o wycenę"
              class="md:text-xl clamp-[px,6,10] clamp-[py,4,5]
                     box-border touch-manipulation rounded-full transition-colors ease-out 
                     focus-visible:outline-none focus-visible:shadow-focus cursor-pointer
                     relative isolate text-white
                     before:content-[''] 
                     before:absolute 
                     before:inset-0 
                     before:-z-10 
                     before:rounded-full 
                     before:pointer-events-none 

                     border-accent-hover border-[1px]
                     bg-accent-gradient 
                     shadow-accent-gradient 
                     
                     before:bg-accent-gradient-hover 
                     before:shadow-accent-gradient-inner">

        <span class="c-contactform__spinner is-hidden"
              id="spinner"></span><span class="title">Wyślij</span>
      </button>
    </div>
  </fieldset>

  <fieldset class="c-contactform__thanks is-hidden"
            id="formThanks">
    <p class="mb-6 text-2xl">Dziękuję za kontakt!</p>

    <p class="text-xl">
      Cieszę się, że zdecydowałeś się napisać.<br>
      Odpowiem tak szybko, jak to tylko możliwe.
    </p>
  </fieldset>
</form>