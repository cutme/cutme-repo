<form action="https://cutme.pl/contact.php"
      method="post"
      id="contactForm"
      novalidate
      class="c-contactform lg:w-1/2">
  <fieldset id="formFields"
            class="js-fadeInChildren ">
    <span class="input">
      <label class="input__label"
             for="input-0">
        <span class="input__label-content">Z kim mam przyjemność?</span>
      </label>
      <input class="input__field"
             type="text"
             id="input-0"
             name="name"
             autocomplete="off" />

      <svg class="graphic"
           width="300%"
           height="100%"
           viewBox="0 0 1200 60"
           preserveAspectRatio="none">

        <path
              d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0" />
      </svg>
    </span>

    <span class="input">
      <label class="input__label"
             for="input-1">
        <span class="input__label-content">Twój adres e-mail</span>
      </label>
      <input class="input__field"
             type="email"
             id="input-1"
             name="email"
             autocomplete="off" />

      <svg class="graphic"
           width="300%"
           height="100%"
           viewBox="0 0 1200 60"
           preserveAspectRatio="none">

        <path
              d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0" />
      </svg>
    </span>

    <span class="input">
      <label class="input__label"
             for="input-2">
        <span class="input__label-content">W czym mogę pomóc?</span>
      </label>
      <textarea rows="1"
                class="input__field input__field--textarea"
                id="input-2"
                name="message"></textarea>

      <svg class="graphic"
           width="300%"
           height="100%"
           viewBox="0 0 1200 60"
           preserveAspectRatio="none">

        <path
              d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0" />
      </svg>
    </span>

    <div class="mt-6 mb-12 duration-150 dropzone" id="my-dropzone" name="file[]"></div>

    <div id="recaptcha" class="mb-6"></div>

    <div class="c-contactform__submit">
      <button type="submit"
              class="o-btn o-btn--primary o-btn--big"
              id="submita">
        <span class="c-contactform__spinner is-hidden"
              id="spinner"></span><span class="title">Wyślij</span>
      </button>
    </div>
  </fieldset>

  <fieldset class="c-contactform__thanks is-hidden"
            id="formThanks">
    <h4 class="mb-6 text-2xl">Dziękuję za kontakt!</h4>

    <p class="text-xl">
      Cieszę się, że zdecydowałeś się napisać.<br>
      Odpowiem tak szybko, jak to tylko możliwe.
    </p>
  </fieldset>
</form>