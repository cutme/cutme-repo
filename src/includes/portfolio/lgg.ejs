<div class="c-portfolio__item c-portfolio__item--big" onclick="window.open('https://lgg.cutme.pl/', '_blank')">    				
    <% include ../corner %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">Let's Grow Gdańsk</h3>
        <p itemprop="description" class="~text-sm/base"><strong>Zakodowanie projektu graficznego</strong> na potrzeby wydarzenia organizowanego przez agencję Semcore w Gdańsku. Projekt skierowany do społeczności marketingowej, skupionej wokół idei Growth Mindset – ludzi otwartych na rozwój w&nbsp;dziedzinie marketingu oraz życia zawodowego. Treści zostały przekazane w&nbsp;sposób dynamiczny, podkreślając energię i&nbsp;zaangażowanie uczestników.</p>
        <button class="o-btn o-btn--primary o-btn--small" type="button">Zobacz online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" srcset="<%=require("./img/portfolio/lgg.webp")%> 1x, 
            			              <%=require("./img/portfolio/lgg@2x.webp")%> 2x" 
            			              alt="Projekt graficzny przekształcony w responsywną stronę HTML" loading="lazy" width="800" height="480" 
            			              src=<%=require("./img/portfolio/lgg.webp")%> />
    </picture>
</div>
