<div class="relative ~pl-6/24 ~pr-6/24 bg-white c-contact"
		 id="contact">
	<div class="~pt-16/40 o-wrap js-fadeInChildren">
		<p class="md:max-w-[90%] ~mb-14/32 ~text-2xl/4xl">Chcesz, aby Twój projekt graficzny został wdrożony zgodnie
			z&nbsp;najlepszymi praktykami, był w&nbsp;pełni responsywny, dopracowany w&nbsp;każdym detalu i&nbsp;robił
			świetne wrażenie? Dobrze trafiłeś!</p>

		<div class="relative lg:flex lg:justify-between ~pb-16/40">
			<ul class="c-contact__social ~mb-14/32 ~text-xl/3xl ~space-y-1/3 js-fadeInChildren">
				<li class="flex items-center"><i class="w-6 ~mr-2/6 text-center icon-envelope-o"></i>
					<script>
						var part1 = "info";
						var part2 = Math.pow(2, 6);
						var part3 = String.fromCharCode(part2);
						var part4 = "cutme.pl";
						var part5 = part1 + String.fromCharCode(part2) + part4;
						document.write("<a class='u-link' itemprop='email' href=" + "mai" + "lto" + ":"
							+ part5 + ">" + part1 + part3 + part4 + "</a>");
					</script>
				</li>
				<li class="flex items-center"><i class="w-6 ~mr-2/6 text-center icon-device-mobile"></i><a itemprop="telephone"
						 href="tel:691630013"
						 class="u-link">691 630 013</a></li>
				<li class="flex items-center"><i class="w-6 ~mr-2/6 text-center icon-messenger"></i><a
						 href="http://m.me/cutmepl"
						 target="_blank"
						 class="u-link">Messenger</a></li>
				<!--                         <li><i class="icon-skype"></i><a href="skype:bartoszm">Skype</a></li> -->
			</ul>

			<form action="https://cutme.pl/contact.php"
						method="post"
						id="contactForm"
						novalidate
						class="c-contactform lg:w-1/2">
				<fieldset id="formFields"
									class="js-fadeInChildren">
					<span class="input">
						<label class="input__label"
									 for="input-0">
							<span class="input__label-content">Z kim mam przyjemność?</span>
						</label>
						<input class="input__field"
									 type="text"
									 id="input-0"
									 name="name"
									 autocomplete="off" />

						<svg class="graphic"
								 width="300%"
								 height="100%"
								 viewBox="0 0 1200 60"
								 preserveAspectRatio="none">

							<path
										d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0" />
						</svg>
					</span>

					<span class="input">
						<label class="input__label"
									 for="input-1">
							<span class="input__label-content">Twój adres e-mail</span>
						</label>
						<input class="input__field"
									 type="email"
									 id="input-1"
									 name="email"
									 autocomplete="off" />

						<svg class="graphic"
								 width="300%"
								 height="100%"
								 viewBox="0 0 1200 60"
								 preserveAspectRatio="none">

							<path
										d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0" />
						</svg>
					</span>

					<span class="input">
						<label class="input__label"
									 for="input-2">
							<span class="input__label-content">W czym mogę pomóc?</span>
						</label>
						<textarea rows="1"
											class="input__field input__field--textarea"
											id="input-2"
											name="message"></textarea>

						<svg class="graphic"
								 width="300%"
								 height="100%"
								 viewBox="0 0 1200 60"
								 preserveAspectRatio="none">

							<path
										d="M0,56.5c0,0,298.666,0,399.333,0C448.336,56.5,513.994,46,597,46c77.327,0,135,10.5,200.999,10.5c95.996,0,402.001,0,402.001,0" />
						</svg>
					</span>

					<div id="recaptcha"></div>

					<div class="c-contactform__submit">
						<button type="submit"
										class="o-btn o-btn--primary o-btn--big"
										id="submita">
							<span class="c-contactform__spinner is-hidden"
										id="spinner"></span><span class="title">Wyślij</span>
						</button>
					</div>
				</fieldset>

				<fieldset class="c-contactform__thanks is-hidden"
									id="formThanks">
					<h4>Dziękuję za kontakt!</h4>

					<p>
						Cieszę się, że zdecydowałeś się napisać.<br>
						Odpowiem tak szybko, jak to tylko możliwe.
					</p>
				</fieldset>
			</form>

			<p class="absolute text-sm duration-150 lg:right-0 bottom-12 opacity-30 hover:opacity-50">&copy; <a
					 href="https://mediger.net"
					 target="_blank">mediger.net</a></p>
		</div>
	</div>
</div>