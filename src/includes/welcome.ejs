<div class="relative z-10 flex ~px-6/24 flex-col items-center justify-center text-white c-welcome  after:absolute after:opacity-3 after:pointer-events-none after:size-full after:bg-[24px_24px] after:[background-size:25px_25px] gs-parallax
         lg:h-lvh
         max-lg:py-32">
  <img style="visibility: hidden" itemprop="logo" src=<%= require("./img/assets/logo-white.svg") %>
				 loading="lazy" width="145" height="28" alt="cutme" class="absolute logo ~left-6/12 top-12 opacity-30" />


  <div class="flex flex-col max-w-3xl">
    <h1 class="max-w-xl lg:max-w-screen-md mb-4 ~text-3xl/5xl order-2 font-roslindale !leading-snug opacity-0">
      <span class="char1 md:text-nowrap">Potrzebujesz wsparcia przy wdrożeniu</span>
      <span class="char2 md:text-nowrap">lub kodowaniu projektu?</span>
    </h1>

    <h2 class="tracking-wide mb-4 ~text-xs/base opacity-50 font-light order-1"
        style="visibility: hidden">Bartosz Mediger, front-end developer</h2>

    <p class="text-balance order-3 max-w-2xl mb-10 ~text-base/xl font-light tracking-wide gsap-three js-nowidows"
