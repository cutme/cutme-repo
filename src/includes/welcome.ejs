              data-speed="2">kontakt</button>
      <span class="pl-6 border-l border-l-gray-800">
        <a href="/en"
           class="hidden mr-6 text-sm uppercase duration-150 opacity-30 hover:opacity-70 sm:block">en</a>
      </span>
      <a href="https://github.com/cutme?tab=repositories"
         target="_blank"
         class="block ml-12 text-2xl icon-github opacity-30 hover:opacity-50"
         aria-label="View GitHub repositories"></a>
    </nav>

    <div class="order-4 opacity-0 o-more">
      <button class="o-btn md:text-xl ~px-6/10 ~py-4/5"
              data-target="#portfolio"
              data-speed="1">Zobacz więcej</button>

      <!-- <button class="o-btn o-btn--oval o-btn--primary"
              data-target="#portfolio"
              data-speed=".5">Zobacz realizacje</button> -->
    </div>
  </div>
  <!-- 
  <img src="<%= require("./img/assets/arrow-02.svg") %>" alt=""
  class="absolute bottom-0 right-0" /> -->


  <div class="absolute bottom-0 scale-75 opacity-30 right-10 arrow-portfolio max-lg:hidden"
       style="visibility: hidden">
    <img src="<%= require("./img/assets/arrow-02.svg") %>" alt=""/>
    <p
       class="absolute top-0 transform -rotate-6 tracking-wider right-1 text-xl text-white normal-case font-light -translate-y-[130%]">
      portfolio</p>
  </div>
