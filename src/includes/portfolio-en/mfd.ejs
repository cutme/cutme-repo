<div class="c-portfolio__item c-portfolio__item--18 c-portfolio__item--big" onclick="window.open('https://mfd.cutme.pl', '_blank')">    				
    <% include ../corner %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">MFD</h3>
        <p itemprop="description" class="~text-sm/base">Comprehensive order for <strong>coding of graphic design</strong> and <strong>implementation to Wordpress</strong> for a Start-up in the railcar fleet sector. Modern approach in this industry highlighted by many animations.</p>
        <button class="o-btn o-btn--primary o-btn--small" type="button">See online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" srcset="<%=require("../img/portfolio/mfd.webp")%> 1x, 
            			              <%=require("../img/portfolio/mfd@2x.webp")%> 2x" 
            			              alt="Implementation of GSAP animation in the graphic design of the MFD website" loading="lazy" width="800" height="480" 
            			              src=<%=require("../img/portfolio/mfd.webp")%> />
    </picture>
</div>
