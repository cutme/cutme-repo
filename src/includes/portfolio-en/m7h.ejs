<div class="m7h c-portfolio__item" onclick="window.open('https://m7h.cutme.pl', '_blank')">
    <% include ../corner %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">m7h</h3>
        <p itemprop="description" class="~text-sm/base">Project from <a href="https://klosinski.net" target="_blank" onclick="event.stopPropagation()">Jacek Kłosiński</a>, who promoted his marketing system "7 Godzin". Code semantics and SEO optimization were to facilitate his further positioning.</p>
        <button class="o-btn o-btn--primary o-btn--small" type="button">See online</button>
	</article>  
	<picture class="relative block">
        <img itemprop="image" srcset="<%=require("../img/portfolio/m7h.webp")%> 1x, 
    					              <%=require("../img/portfolio/m7h@2x.webp")%> 2x" 
    					              alt="m7h" loading="lazy" width="400" height="480" 
    					              src=<%=require("../img/portfolio/m7h.webp")%> />
	</picture>
</div>