<div class="c-portfolio__item c-portfolio__item--big c-portfolio__item--17" onclick="window.open('https://flowair.cutme.pl', '_blank')">
    <% include ../corner %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">FlowAir</h3>
        <p itemprop="description" class="~text-sm/base"><strong>Coding the graphic design</strong> of a page presenting the SLIM air curtain. The client asked for a dynamic presentation of their product, so we have implemented time-lapse videos, parallax and a dedicated gallery script.</p>
        <button class="o-btn o-btn--primary o-btn--small" type="button">See online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" srcset="<%=require("../img/portfolio/flowair.webp")%> 1x, 
    					              <%=require("../img/portfolio/flowair@2x.webp")%> 2x" 
    					              alt="Responsive website design, pixel perfect in HTML and CSS Flowair" loading="lazy" width="800" height="480" 
    					              src=<%=require("../img/portfolio/flowair.webp")%> />
    </picture>
</div>

