<div class="c-portfolio__item c-portfolio__item--big c-portfolio__item--12" onclick="window.open('https://klosinski.net/metodateczowki/', '_blank')">
    <% include ../corner %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">Metoda Tęczówki</h3>
        <p itemprop="description" class="~text-sm/base">As part of this project, I was responsible for <strong>coding the website</strong> and animations. Thanks to carefully selected effects and attention to detail, we managed to achieve an effect that attracted the attention of not only users, but also industry experts. The website was recognized by <a href="https://css-awards.com/website/metoda-teczowki-by-jacek-klosinski/" target="_blank" class="text-nowrap" onclick="event.stopPropagation();">CSS Awards</a>.</p>
        <button class="o-btn o-btn--primary o-btn--small" type="button">See online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" srcset="<%=require("../img/portfolio/met.webp")%> 1x, 
        				              <%=require("../img/portfolio/met@2x.webp")%> 2x" 
        				              alt="Professional coding of a website with a graphic design in the Pixel Perfect style. The Iris Method" loading="lazy" width="800" height="480" 
        				              src=<%=require("../img/portfolio/met.webp")%> />
    </picture>
</div>

