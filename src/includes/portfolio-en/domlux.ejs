<div class="domlux c-portfolio__item c-portfolio__item--21__ c-portfolio__item--narrow" onclick="window.open('https://domlux.cutme.pl', '_blank')">
    <% include ../corner %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">DomLux</h3>
        <p itemprop="description" class="~text-sm/base">Coding the project of a website of a manufacturer of exclusive furniture. Our common denominator in this implementation was attention to detail and aesthetics of workmanship.</p>
        <button type="button" class="o-btn o-btn--primary o-btn--small">See online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" 
             srcset="<%=require("../img/portfolio/domlux.webp")%> 1x, 
    	             <%=require("../img/portfolio/domlux@2x.webp")%> 2x" 
             alt="Coding a website according to Pixel Perfect principles" loading="lazy" width="400" height="480" 
             src=<%=require("../img/portfolio/domlux.webp")%> />					             
	</picture>
</div>
