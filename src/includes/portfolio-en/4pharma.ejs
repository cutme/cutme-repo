<div class="4pharma c-portfolio__item c-portfolio__item--big" onclick="window.open('https://4pharma.cutme.pl', '_blank')"> 
    <% include ../corner %>
    <article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">4pharma</h3>
        <p itemprop="description" class="~text-sm/base">Implementation for a digital consulting agency providing solutions for the modern pharmaceutical market. My task was to <strong>code a dynamic page</strong> using the parallax effect based on the project.</p>
        <button class="o-btn o-btn--primary o-btn--small" type="button">See online</button>
	</article>   
	<picture class="relative block"> 					
    <img itemprop="image" srcset="<%=require("../img/portfolio/4pharma.webp")%> 1x, 
					              <%=require("../img/portfolio/4pharma@2x.webp")%> 2x" 
					              alt="Coding of 4pharma graphic design for website, responsiveness in HTML and CSS" loading="lazy" width="800" height="480" 
					              src=<%=require("../img/portfolio/4pharma.webp")%> />
    </picture>
</div>