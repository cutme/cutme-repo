<div class="c-portfolio__item c-portfolio__item--big c-portfolio__item--07" 
         onclick="window.open('https://brandhub.cutme.pl/', '_blank')">
         <% include ../corner %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">BrandHub</h3>
        <p itemprop="description" class="~text-sm/base">The order to <strong>code the project</strong> required precise reproduction of the graphic layout while maintaining the Pixel Perfect standard to ensure a professional and modern look.</p>
        <button class="o-btn o-btn--primary o-btn--small" type="button">See online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" srcset="<%=require("../img/portfolio/brandhub.webp")%> 1x, 
    					              <%=require("../img/portfolio/brandhub@2x.webp")%> 2x" 
    					              alt="PSD to HTML/CSS conversion for BrandHub project" loading="lazy" width="800" height="480" 
    					              src=<%=require("../img/portfolio/brandhub.webp")%> />
    </picture>
</div>