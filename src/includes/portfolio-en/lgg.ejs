<div class="c-portfolio__item c-portfolio__item--big" onclick="window.open('https://lgg.cutme.pl/', '_blank')">    				
    <% include ../corner %>
	<article itemscope itemtype="https://schema.org/Project">
        <h3 itemprop="name">Let's Grow Gdańsk</h3>
        <p itemprop="description" class="~text-sm/base"><strong>Coding a graphic design</strong> for an event organized by the Semcore agency in Gdańsk. The project was aimed at the marketing community, focused around the idea of ​​Growth Mindset – people open to development in the field of marketing and professional life. The content was delivered in a dynamic way, emphasizing the energy and commitment of the participants.</p>
        <button class="o-btn o-btn--primary o-btn--small" type="button">See online</button>
	</article>
	<picture class="relative block">
        <img itemprop="image" srcset="<%=require("../img/portfolio/lgg.webp")%> 1x, 
            			              <%=require("../img/portfolio/lgg@2x.webp")%> 2x" 
            			              alt="Graphic design transformed into a responsive HTML page" loading="lazy" width="800" height="480" 
            			              src=<%=require("../img/portfolio/lgg.webp")%> />
    </picture>
</div>
