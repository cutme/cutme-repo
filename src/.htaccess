RewriteEngine On

# Domyślny plik katalogowy
DirectoryIndex index.html

# ── HTTPS — wymuszenie szyfrowania ────────────────────────────────────────
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Canonical domain — www → bez www ──────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.cutme\.pl$ [NC]
RewriteRule ^(.*)$ https://cutme.pl/$1 [R=301,L]

# ── Ukryj index.html z URL ────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} ^/en/index\.html$ [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# ── Canonical trailing slash na katalogach ────────────────────────────────
# SEO: /portfolio/flowair i /portfolio/flowair/ → jeden kanoniczny URL
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L]

# ── Statyczne pliki — serwuj bezpośrednio ─────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Katalogi z index.html — serwuj bezpośrednio ───────────────────────────
# /portfolio/slug/ → dist/portfolio/slug/index.html
# /en/portfolio/slug/ → dist/en/portfolio/slug/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── SPA fallback ──────────────────────────────────────────────────────────
RewriteRule ^ /index.html [L]

# ── Typy MIME dla fontów i SVG ────────────────────────────────────────────
AddType application/vnd.ms-fontobject .eot
AddType application/x-font-ttf        .ttf
AddType application/x-font-opentype   .otf
AddType application/x-font-woff       .woff
AddType image/svg+xml                 .svg

# ── Cache: nagłówki wygasania ─────────────────────────────────────────────
# Vite generuje hashe w nazwach assetów (app-Ca4GwEjJ.js) — można je cachować agresywnie.
# HTML nie ma hashy — krótki cache żeby zmiany były widoczne od razu.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 seconds"

    # HTML — zawsze świeży (brak hash w nazwie)
    ExpiresByType text/html                 "access plus 1 seconds"

    # Obrazy — długi cache (favicon, OG image itp.)
    ExpiresByType image/x-icon             "access plus 2592000 seconds"
    ExpiresByType image/gif                "access plus 2592000 seconds"
    ExpiresByType image/jpeg               "access plus 2592000 seconds"
    ExpiresByType image/png                "access plus 2592000 seconds"
    ExpiresByType image/webp               "access plus 2592000 seconds"
    ExpiresByType image/svg+xml            "access plus 1 year"

    # CSS i JS — Vite dodaje hash, więc można cachować bardzo długo
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType text/javascript          "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"

    # Fonty — niezmienne, maksymalny cache
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/x-font-ttf        "access plus 1 year"
    ExpiresByType application/x-font-opentype   "access plus 1 year"
    ExpiresByType application/x-font-woff       "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
</IfModule>
